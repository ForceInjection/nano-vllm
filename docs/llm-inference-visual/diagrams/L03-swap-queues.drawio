      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="第 3 课：三队列生命周期与 swap 数据流（waiting / running / swapped）" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1020" height="30" as="geometry" />
        </mxCell>

        <!-- 左列：三个队列 -->
        <mxCell id="waiting" value="waiting · WAITING&#xa;新请求 + RECOMPUTE 回退（appendleft 优先重试）" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1D4ED8;strokeWidth=2;fillColor=#DBEAFE;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="110" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="running" value="running · RUNNING&#xa;decode 每步 1 token（FIFO + extendleft）" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#047857;strokeWidth=2;fillColor=#D1FAE5;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="340" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="swapped" value="swapped · SWAPPED&#xa;KV 驻留 CPU，等 GPU 有空块迁回" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#6D28D9;strokeWidth=2;fillColor=#EDE9FE;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="590" width="300" height="90" as="geometry" />
        </mxCell>

        <!-- 队列间转移（边不带标签，标签用独立文本单元精确定位） -->
        <mxCell id="e_wr" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#111827;strokeWidth=2;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="waiting" target="running">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_wr" value="schedule 首次选中 + allocate" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="248" y="258" width="200" height="24" as="geometry" />
        </mxCell>
        <mxCell id="e_rw" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#B91C1C;strokeWidth=2;html=1;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="running" target="waiting">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="30" y="385" />
              <mxPoint x="30" y="155" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_rw" value="RECOMPUTE 兜底&#xa;（CPU 满 / 含共享块）&#xa;deallocate + appendleft" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B91C1C;" vertex="1" parent="1">
          <mxGeometry x="42" y="238" width="150" height="64" as="geometry" />
        </mxCell>
        <mxCell id="e_rs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6D28D9;strokeWidth=2;html=1;endArrow=block;endFill=1;exitX=0.25;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="running" target="swapped">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_rs" value="preempt + swap_out&#xa;{gpu_id: cpu_id}" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#6D28D9;" vertex="1" parent="1">
          <mxGeometry x="40" y="492" width="110" height="36" as="geometry" />
        </mxCell>
        <mxCell id="e_sr" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#047857;strokeWidth=2;html=1;endArrow=block;endFill=1;exitX=0.8;exitY=0;entryX=0.8;entryY=1;" edge="1" parent="1" source="swapped" target="running">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_sr" value="swap-in（decode step 开头）&#xa;重建 block_table · 断点续跑" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#047857;" vertex="1" parent="1">
          <mxGeometry x="330" y="492" width="190" height="36" as="geometry" />
        </mxCell>

        <!-- 右上面板：swap 数据流 -->
        <mxCell id="panel" value="swap 数据流：Scheduler 只产出映射，模型执行端在 step() 内完成拷贝" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#111827;strokeWidth=2;fillColor=#F9FAFB;fontSize=13;fontStyle=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="440" y="110" width="620" height="300" as="geometry" />
        </mxCell>
        <mxCell id="sched" value="Scheduler.schedule（纯元数据）&#xa;preempt → blocks_to_swap_out {gpu_id: cpu_id}&#xa;swap-in 阶段 → blocks_to_swap_in {cpu_id: gpu_id}" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1D4ED8;strokeWidth=2;fillColor=#DBEAFE;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="155" width="270" height="100" as="geometry" />
        </mxCell>
        <mxCell id="kvswap" value="kv_swap.swap_blocks（拷贝本体）&#xa;dst[:, :, dst_id].copy_(src[:, :, src_id])&#xa;一次切片覆盖所有层 + K/V" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#B45309;strokeWidth=2;fillColor=#FFEDD5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="155" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="gputensor" value="GPU kv_cache 大张量&#xa;[2, L, num_blocks, block_size, kv_heads, head_dim]" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#B45309;strokeWidth=2;fillColor=#FFF7ED;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="295" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cputensor" value="CPU cpu_kv_cache（pinned）&#xa;同布局镜像 · 不参与前缀缓存" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#B45309;strokeWidth=2;fillColor=#FFF7ED;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="295" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e_sched_kv" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#111827;strokeWidth=2;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sched" target="kvswap">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6D28D9;strokeWidth=2;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" edge="1" parent="1" source="gputensor" target="cputensor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_out" value="swap_out（先）" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#6D28D9;" vertex="1" parent="1">
          <mxGeometry x="720" y="298" width="100" height="18" as="geometry" />
        </mxCell>
        <mxCell id="e_in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#047857;strokeWidth=2;html=1;endArrow=block;endFill=1;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="cputensor" target="gputensor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_in" value="swap_in（后）" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#047857;" vertex="1" parent="1">
          <mxGeometry x="720" y="354" width="100" height="18" as="geometry" />
        </mxCell>

        <!-- 右列说明框 -->
        <mxCell id="r1" value="顺序约束 R1（正确性）：swap_out 拷贝 → swap_in 拷贝 → run()。&#xa;被换出释放的 GPU 块可能当步就被复用：先读走、再覆盖、最后才前向。" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#111827;strokeWidth=2;fillColor=#F9FAFB;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="560" width="620" height="60" as="geometry" />
        </mxCell>
        <mxCell id="guard" value="护栏：本 step 刚 swap_in 的 seq 不得 swap_out——其 GPU 块中 KV 尚未拷回（垃圾数据），&#xa;preempt 命中护栏则取消 swap-in 映射、改走 RECOMPUTE（scheduler.py preempt 开头）。" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#B91C1C;strokeWidth=2;fillColor=#FEE2E2;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="640" width="620" height="60" as="geometry" />
        </mxCell>
        <mxCell id="counters" value="观测计数器：num_swapped_out_blocks / num_swapped_in_blocks / num_recompute_preemptions&#xa;（tests/verify_swap.py 断言 swap 路径真的跑过，防止空转测试）" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#047857;strokeWidth=2;fillColor=#ECFDF5;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="720" width="620" height="50" as="geometry" />
        </mxCell>

        <mxCell id="source_note" value="代码锚点：nanovllm/engine/scheduler.py（waiting/running/swapped · preempt · _recompute）· block_manager.py（can_swap_out / swap_out / swap_in）&#xa;· kv_swap.py · llm_engine.py step()　　设计 + 验证记录：docs/design/kv-offload.md（开关：Config.cpu_offload_gb，默认 0 = 关闭）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#374151;" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="1020" height="40" as="geometry" />
        </mxCell>
